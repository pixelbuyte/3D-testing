{
  "name": "echoes-of-the-shrine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Echoes of the Shrine — a small cinematic 3D browser game built on PlayCanvas Engine 2.x (WebGPU-first, WebGL2 fallback).",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "screenshot": "node tools/screenshot.mjs"
  },
  "dependencies": {
    "playcanvas": "^2.21.4"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@types/node": "^26.4.1",
    "@webgpu/types": "^0.1.72",
    "ffmpeg-static": "^5.3.0",
    "meshoptimizer": "^1.2.0",
    "sharp": "^0.33.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  }
}
